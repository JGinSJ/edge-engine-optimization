<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd job for the Apple refurbished stock checker.

  1. Edit the paths marked >>> below to match your Mac and username.
  2. Put your SMTP app password (and Twilio token, if used) in the
     EnvironmentVariables block — launchd does NOT read your shell profile,
     so secrets referenced as "env:NAME" in config.json must be set here.
  3. Install:
        cp com.user.apple-refurb-checker.plist ~/Library/LaunchAgents/
        launchctl load ~/Library/LaunchAgents/com.user.apple-refurb-checker.plist
     Reload after edits:
        launchctl unload ~/Library/LaunchAgents/com.user.apple-refurb-checker.plist
        launchctl load   ~/Library/LaunchAgents/com.user.apple-refurb-checker.plist

  StartInterval is in seconds (900 = every 15 minutes). The job also runs once
  at load (RunAtLoad) and catches up if your Mac was asleep at the scheduled time.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.apple-refurb-checker</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <!-- >>> full path to refurb_checker.py -->
        <string>/Users/USERNAME/apple-refurb-stock-checker/refurb_checker.py</string>
    </array>

    <!-- >>> the folder containing refurb_checker.py and config.json -->
    <key>WorkingDirectory</key>
    <string>/Users/USERNAME/apple-refurb-stock-checker</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>REFURB_SMTP_PASSWORD</key>
        <string>your-gmail-app-password-here</string>
        <!-- <key>TWILIO_AUTH_TOKEN</key><string>your-twilio-token</string> -->
    </dict>

    <key>StartInterval</key>
    <integer>900</integer>

    <key>RunAtLoad</key>
    <true/>

    <!-- >>> log paths (create the folder or point somewhere writable) -->
    <key>StandardOutPath</key>
    <string>/Users/USERNAME/apple-refurb-stock-checker/checker.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/USERNAME/apple-refurb-stock-checker/checker.log</string>
</dict>
</plist>
